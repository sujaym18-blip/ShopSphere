{
  "name": "shopsphere",
  "version": "1.0.0",
  "description": "Full-Stack MERN E-Commerce Application",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon backend/server.js",
    "start": "node backend/server.js",
